    "database-clients": {
      "description": "Database GUI clients and management tools",
      "enabled": false,
      "required": false,
      "prompt_message": "Install database GUI clients?",
      "packages": {
        "dbeaver-community": {
          "enabled": false,
          "type": "cask",
          "description": "Universal database tool",
          "required": false,
          "ubuntu": {
            "method": "apt-repo",
            "setup_commands": [
              "curl -fsSL https://dbeaver.io/debs/dbeaver.gpg.key | sudo gpg --dearmor -o /usr/share/keyrings/dbeaver.gpg",
              "echo 'deb [signed-by=/usr/share/keyrings/dbeaver.gpg] https://dbeaver.io/debs/dbeaver-ce /' | sudo tee /etc/apt/sources.list.d/dbeaver.list",
              "sudo apt update"
            ],
            "package": "dbeaver-ce"
          }
        },
        "pgadmin4": {
          "enabled": false,
          "type": "cask",
          "description": "PostgreSQL administration tool",
          "required": false,
          "ubuntu": {
            "method": "apt-repo",
            "setup_commands": [
              "curl -fsS https://www.pgadmin.org/static/packages_pgadmin_org.pub | sudo gpg --dearmor -o /usr/share/keyrings/packages-pgadmin-org.gpg",
              "echo 'deb [signed-by=/usr/share/keyrings/packages-pgadmin-org.gpg] https://ftp.postgresql.org/pub/pgadmin/pgadmin4/apt/$(lsb_release -cs) pgadmin4 main' | sudo tee /etc/apt/sources.list.d/pgadmin4.list",
              "sudo apt update"
            ],
            "package": "pgadmin4-desktop"
          }
        },
        "mongodb-compass": {
          "enabled": false,
          "type": "cask",
          "description": "MongoDB GUI client",
          "required": false,
          "ubuntu": {
            "method": "mongodb-compass",
